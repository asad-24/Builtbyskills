NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_PROVIDER=mongodb
# Server-only Atlas URI. Never use a NEXT_PUBLIC_ prefix for database credentials.
MONGODB_URI=
MONGODB_DB=builtbyskills
# Generate once, keep the same value across Vercel instances/deployments.
BETTER_AUTH_SECRET=
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Builtbyskills
# Optional: private R2 lesson video uploads/playback.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=builtbyskills-course-videos
NEXT_PUBLIC_SENTRY_DSN=
