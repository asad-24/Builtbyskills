# Copy this file to .env.lms-test. Never use the project's production credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_TEST_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_TEST_SECRET_KEY
# Legacy alternatives: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# Use the connection string for this SAME disposable project, from Supabase Connect.
LMS_TEST_DATABASE_URL=postgresql://postgres.YOUR_TEST_PROJECT:REPLACE_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
